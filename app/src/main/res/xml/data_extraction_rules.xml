<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- In an e-commerce app, exclude cached preferences and credentials from unencrypted cloud backup -->
        <exclude domain="sharedpref" path="vastra_store.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
